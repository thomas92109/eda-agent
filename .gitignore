# Altium editor artefacts (generated on open/save)
__Previews/
History/
scripts/altium/*.tmp.*
scripts/altium/TestUtils.exe

# Monolithic build artefact (regenerated by `python scripts/altium/build.py`)
scripts/altium/Altium_MCP.pas

# Deployed copy of scripts/altium that live Altium compiles and runs. Same
# sources, plus the editor's own History/__Previews; never edited in place.
altium-scripts/

# Free Pascal / test build artefacts
*.o
*.ppu
*.or
*.bak
tests/*.exe
tests/Altium_MCP_fpc.pas
tests/test_compile.pas
tests/cross_validate_pascal.exe
tests/test_pascal_logic.exe
tests/test_real_pascal.exe

# Runtime / scratch
workspace/
*.log

# Local Altium SDK reference material (not redistributable)
reference/

# Per-session executor fixture artefacts (generated by tests/integration runs)
tests/integration/fixtures/main.SchDoc
tests/integration/fixtures/EDAAgentTest.PcbDoc
tests/integration/fixtures/EDAAgentTest_ICs.SchLib
tests/integration/fixtures/EDAAgentTest_Export.OutJob
tests/integration/fixtures/schematic_snapshot.*

# Render previews + symbol cache (regenerated by the design engine; scratch)
.design_previews/
.symbol_cache/

# Local Claude Code session / tooling config (machine-local, never committed)
.claude/

# Atomic-write temp leftovers (editors / Dropbox)
*.tmp.*

# Built EasyEDA extension entry point; produced by
# extensions/easyeda/build.py, same treatment as the Altium bundle.
extensions/easyeda/dist/

extensions/easyeda/verified.json
extensions/easyeda/*.eext

# The Rust route core's build output
route-core/target/

# ---------------------------------------------------------------------------
# Proprietary engineering and purchasing data: never commit. Patterns match
# data files by extension or by specific name, never by a bare word, so
# source files such as bom.py or purchasing_plan.py stay tracked. Synthetic
# test fixtures are re-included below their rules.

# Spreadsheets and CSV exports (BOMs, purchasing lists, distributor exports)
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.xlsb
*.ods
!tests/**/fixtures/**/*.csv
!tests/**/fixtures/**/*.tsv

# Databases (copies of the distributor cache, project databases)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.db-journal

# Purchasing and BOM output, by name
*purchasing*.json
*purchasing*.html
*bom*.json
*bom*.html

# Local data folders: nothing inside them is committed
local-data/
purchasing-data/
boms/

# Credentials, tokens and key material
*.p12
*.jks
*.keystore
*.token
*.tokens.json
*token*.json
*client_secret*
*credentials*.json
*secret*.json
.netrc

# Altium and KiCad design files (projects, schematics, PCBs, libraries, outputs)
*.SchDoc
*.PcbDoc
*.SchLib
*.PcbLib
*.PrjPcb
*.OutJob
*.kicad_pcb
*.kicad_sch
*.kicad_pro
*.kicad_prl

# More Altium files: the project's own spelling (.PrjPCB), libraries,
# templates, and the folders Altium writes beside a project. Not *.PrjScr:
# scripts/altium/Altium_API.PrjScr is EDA Agent's own script project.
*.PrjPCB
*.PrjPcbStructure
*.IntLib
*.DbLib
*.LibPkg
*.SchDot
*.PcbDwf
# The tracked test fixtures, re-included after every rule above that matches
# them (the order matters, and Windows matches names case-insensitively).
!tests/integration/fixtures/EDAAgentTest.PrjPcb
!tests/integration/fixtures/EDAAgentTest.PrjPcbStructure

# Folders Altium writes beside a project
Project Outputs for */
Project Logs for */

# Netlists (Protel / Altium)
*.NET

# Manufacturing outputs (Gerber, drill, 3D models)
*.gbr
*.gtl
*.gbl
*.gto
*.gbo
*.gts
*.gbs
*.gtp
*.gbp
*.gko
*.gm1
*.gpt
*.gpb
*.gbrjob
*.xln
*.drl
*.step
*.stp
*.wrl
*.glb

# Purchasing preferences, MPN decisions, cart journals and export folders
# belong in EDA_AGENT_EXPORT_DIR, outside the repository. These catch a copy
# made here. Scoped to the folders the tools write
# (purchasing/mpn_decisions/<project id>.json, purchasing/journal/), so no
# source file is touched.
/config.toml
**/purchasing/mpn_decisions/
**/purchasing/journal/
/exports/
/bom/

# The distributor cache is one SQLite file (distributor-cache.sqlite3, under
# %LOCALAPPDATA% by default, anywhere with EDA_AGENT_DISTRIBUTOR_CACHE_FILE).
# *.sqlite3 is covered above; these are its journal files and any other
# spelling of it. Not docs/DISTRIBUTOR_CACHE_SCHEMA.md or the cache module,
# which use underscores.
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
distributor-cache*
